# Copy this file to .env and fill in a key for LIVE mode.
#   cp .env.example .env
#
# DRY-RUN needs NO keys and NO network, so you can skip all of this for dry-run.
# .env is git-ignored; NEVER commit a real key. Values below are PLACEHOLDERS.

# --- API keys (LIVE mode only) ---------------------------------------------
# OpenAI (used only when --provider openai is selected in live mode).
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (used only when --provider anthropic is selected in live mode).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Optional configuration (CLI flags override these) ---------------------
# Force dry-run everywhere (alternative to --dry-run). Accepts 1/true/yes/on.
# DEEPRESEARCH_DRY_RUN=0

# Force offline mode (never attempt a network fetch; replay cache/fixtures).
# DEEPRESEARCH_OFFLINE=0

# Default LLM provider when not passing --provider: stub | openai | anthropic.
# DEEPRESEARCH_PROVIDER=stub

# Model name for the chosen provider (e.g. gpt-4o-mini, claude-3-5-sonnet-latest).
# DEEPRESEARCH_MODEL=

# Comma-separated public-domain translations to fetch (default: kjv,web,asv).
# Only public-domain codes are allowed; copyrighted ones (niv, esv, ...) are refused.
# DEEPRESEARCH_TRANSLATIONS=kjv,web,asv

# Number of surrounding verses to include around the target verse (default: 5).
# DEEPRESEARCH_CONTEXT_WINDOW=5

# Where to write the JSON + Markdown dossiers (default: output).
# DEEPRESEARCH_OUTPUT_DIR=output

# Where to store the on-disk fetch cache (default: .cache).
# DEEPRESEARCH_CACHE_DIR=.cache
