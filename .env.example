# Copy this file to .env and fill in a key for LIVE mode.
# DRY-RUN needs NO keys and NO network.
# Never commit a real .env (it is git-ignored).

# OpenAI (used only when --provider openai is selected in live mode)
OPENAI_API_KEY=

# Anthropic (used only when --provider anthropic is selected in live mode)
ANTHROPIC_API_KEY=

# Optional: force dry-run everywhere (alternative to --dry-run)
# DEEPRESEARCH_DRY_RUN=1
