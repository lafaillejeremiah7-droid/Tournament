{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepresearch/dossier.schema.json",
  "title": "Deep Research Dossier",
  "description": "Versioned contract for a research dossier produced by the Deep Research agent (bot #1 of the faith-content video pipeline). Built around a 'common misconception vs. deeper truth' spine. Every substantive claim object carries a citation; every run records unavailable sources in gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "query_kind",
    "misconception",
    "deeper_truth",
    "talking_points",
    "citations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Must equal deepresearch.SCHEMA_VERSION."
    },
    "query": {
      "type": "string",
      "description": "Raw user input (verse reference or free-text topic)."
    },
    "query_kind": {
      "type": "string",
      "enum": ["reference", "topic"]
    },
    "resolved_reference": {
      "type": ["string", "null"],
      "description": "Normalized primary reference for a verse query, or null for a topic."
    },
    "resolved_references": {
      "type": "array",
      "description": "All references resolved for this run (primary + surrounding passage + topic anchors).",
      "items": { "type": "string" }
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "misconception": {
      "description": "The surface / common reading most people assume.",
      "$ref": "#/definitions/claim"
    },
    "deeper_truth": {
      "description": "The better-supported, source-anchored meaning.",
      "$ref": "#/definitions/claim"
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["translation", "reference", "text", "citation"],
        "properties": {
          "translation": { "type": "string" },
          "reference": { "type": "string" },
          "text": { "type": "string" },
          "citation": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "original_language_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "transliteration",
          "strongs",
          "language",
          "definition",
          "insight",
          "citation"
        ],
        "properties": {
          "term": { "type": "string" },
          "transliteration": { "type": "string" },
          "strongs": { "type": "string" },
          "language": { "type": "string", "enum": ["Greek", "Hebrew"] },
          "definition": { "type": "string" },
          "insight": { "type": "string" },
          "citation": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "historical_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "citation"],
        "properties": {
          "text": { "type": "string" },
          "citation": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "commentary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "excerpt", "citation"],
        "properties": {
          "source": { "type": "string" },
          "excerpt": { "type": "string" },
          "citation": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "note", "citation"],
        "properties": {
          "reference": { "type": "string" },
          "note": { "type": "string" },
          "citation": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "talking_points": {
      "type": "array",
      "description": "Ordered points sized for an ~8-20 minute long-form text-to-speech script.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "detail", "citations"],
        "properties": {
          "point": { "type": "string" },
          "detail": { "type": "string" },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/definitions/citation" }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "Structured records of sources that were unavailable or returned nothing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "citations": {
      "type": "array",
      "description": "Flat index of every distinct citation referenced in the dossier.",
      "items": { "$ref": "#/definitions/citation" }
    },
    "provider": { "type": "string" },
    "model": { "type": ["string", "null"] }
  },
  "definitions": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "description": "Human-readable source name." },
        "locator": { "type": "string", "description": "Reference, page, section id, or Strong's number." },
        "url": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "citations"],
      "properties": {
        "statement": { "type": "string" },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/citation" }
        }
      }
    }
  }
}
